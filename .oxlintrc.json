{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-perf",
    "vitest",
    "jsx-a11y",
    "promise",
    "typescript"
  ],
  "categories": {
    "correctness": "deny"
  },
  "rules": {
    "no-console": "off",
    "no-await-in-loop": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-extraneous-class": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/*.legacy.*",
    "coverage/**"
  ]
}
