{
  "name": "induktr-studio",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:web": "bun --filter @induktr/web dev",
    "dev:api": "bun --filter @induktr/api dev",
    "install:web": "bun install --filter @induktr/web",
    "install:api": "bun install --filter @induktr/api",
    "add:web": "bun add --filter @induktr/web",
    "add:api": "bun add --filter @induktr/api",
    "add:package": "bun add --filter @induktr/contracts",
    "remove:web": "bun remove --filter @induktr/web",
    "remove:api": "bun remove --filter @induktr/api",
    "remove:package": "bun remove --filter @induktr/contracts",
    "run:web": "bun run --filter @induktr/web",
    "run:api": "bun run --filter @induktr/api",
    "run:package": "bun run --filter @induktr/packages",
    "build": "bun --filter \"*\" build",
    "build:web": "bun --filter @induktr/web build",
    "build:api": "bun --filter @induktr/api build",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "bun": "1.5.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "oxlint packages --fix && tsc --noEmit"
    }
  }
}
